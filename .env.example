APP_NAME="Mesegenerátor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mesegenerator
DB_USERNAME=mesegenerator
DB_PASSWORD=
# Élesben (Aiven) a CA-tanúsítvány útvonala / In production (Aiven) the CA certificate path
MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false

MAIL_MAILER=log

# Admin fiók a seederhez (PRD US-19) / Admin account for the seeder (PRD US-19)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# demo | groq | mistral (Tech Stack 5.1). A demo AI-hívás nélkül működik. / demo works without an AI call.
STORY_GENERATOR=demo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Képek: local (helyben) vagy s3 (Cloudflare R2, élesben) / Images: local or s3 (Cloudflare R2, production)
IMAGES_DISK_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
